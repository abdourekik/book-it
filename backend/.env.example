# Copy this file to `.env` and adjust. `.env` is gitignored and must NEVER be committed.
#   cp .env.example .env

APP_NAME="Book-it API"
ENVIRONMENT=development
DEBUG=true

# Local PostgreSQL from docker-compose.yml. Host port is 15432, not the usual 5432,
# because this machine already runs native PostgreSQL on both 5432 and 5433.
# The password here is local-only and not a secret.
DATABASE_URL=postgresql+psycopg://bookit:bookit@localhost:15432/bookit

# Signing key for JWTs. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone holding this value can forge a token for ANY user. Never commit a real one.
SECRET_KEY=replace-me-with-a-generated-value

# --- Email (optional) ---
# Leave RESEND_API_KEY empty to log emails to the console instead of sending them.
# Get a key at https://resend.com. Never commit a real one.
RESEND_API_KEY=
EMAIL_FROM="Book-it <onboarding@resend.dev>"

# Public URL of the frontend, used for the links inside emails.
APP_BASE_URL=http://localhost:3000
